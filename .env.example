# CivicAI Bangladesh - Environment Variables Configuration
# Copy this file to .env and configure values before starting the application.

# Application Mode & Security
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="CivicAI Bangladesh"
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For SQLite (default development/demonstration):
DATABASE_URL=sqlite:///./database/civicai.db
# For PostgreSQL / PostGIS in Production:
# DATABASE_URL=postgresql+psycopg2://civic_user:civic_password@localhost:5432/civicai_bd

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Rate Limiting & Abuse Prevention
GUEST_SUBMISSION_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=3600

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,mp4,pdf

# AI Configuration
AI_MODEL_DIR=./ai/models
SIMILARITY_THRESHOLD=0.68
DUPLICATE_RADIUS_KM=2.5

# Admin Default Seed (Optional override)
ADMIN_EMAIL=admin@civicai.gov.bd
ADMIN_PASSWORD=Admin@CivicAI2026!
ADMIN_FULL_NAME="Central Platform Administrator"
